+    /// Registers the anchor of a union once its first continuation fixes it.
+    #[inline(never)]
+    fn anchor_open(&mut self, origin: &Span) {
+        self.graph
+            .union_denounced
+            .entry(span_key(origin))
+            .or_insert(false);
