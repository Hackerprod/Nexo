+    /// Contrasts the value of an `else` block with the union anchor.
+    #[inline(never)]
+    fn second_leaf_anchor(
+        &mut self,
+        visit: FactId,
+        progress: &mut IfProgress<'_>,
+        second: &Option<Type>,
+        failed: bool,
+        anchored: bool,
+    ) -> Result<(), Box<Diagnostic>> {
+        let Some(Else::Block(block)) = progress.otherwise else {
+            return Ok(());
+        };
+        if progress.branch_context.expected.is_some() || failed || anchored {
+            return Ok(());
+        }
+        let Some(base) = progress.anchor.clone() else {
