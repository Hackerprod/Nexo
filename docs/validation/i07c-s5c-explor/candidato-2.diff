+
+    /// The single place where a leaf is equated with its union anchor
+    /// (F0-0002 §4.1.2.2 and §4.1.2.4). A compatible equality accumulates in
+    /// any state; the first incompatible one marks the union denounced; later
+    /// ones are rejected atomically without a diagnostic of their own.
+    #[inline(never)]
+    fn anchor_contrast(
+        &mut self,
+        visit: Option<FactId>,
+        base: &(Type, Span),
+        found: Type,
+        found_span: Span,
+    ) -> Result<AnchorOutcome, Box<Diagnostic>> {
+        let key = span_key(&base.1);
+        let state = self.graph.union_denounced.get(&key).copied();
+        let found_span_dbg = found_span.clone();
+        let found_ty_dbg = found.clone();
+        let snapshot = (xv("atomic") && state == Some(true))
+            .then(|| (self.graph.type_nodes.clone(), self.graph.obligations.clone()));
+        let snapshot0 = (xv("atomic0") && state == Some(false))
+            .then(|| self.graph.type_nodes.clone());
+        let before = self.pending_join_count();
+        let outcome = match visit {
+            None => self.unify_independent(
+                base.0.clone(),
+                found,
+                base.1.clone(),
+                found_span.clone(),
+                found_span,
+                true,
+            ),
+            Some(visit) => self.unify(
+                visit,
+                base.0.clone(),
+                found,
+                base.1.clone(),
+                found_span.clone(),
+                found_span,
+                true,
+            ),
+        };
+        let error = match outcome {
+            Err(error) if error.operation == Operation::AnalysisLimit => return Err(error),
+            Err(error) => Some(error),
+            Ok(_) => None,
+        };
+        if xv("dbg") {
+            eprintln!(
+                "CONTRAST pl={} base={:?} found={:?} state={:?} err={} newjoins={}",
+                self.planning,
+                (base.1.start, base.1.end),
+                (found_span_dbg.start, found_span_dbg.end),
+                state,
+                error.is_some(),
+                self.pending_join_count() > before
+            );
+        }
+        if error.is_none() && self.pending_join_count() <= before {
+            if xv("defmark") {
+                for ty in [&base.0, &found_ty_dbg] {
+                    if let Type::Deferred(id) = ty {
+                        let root = self.root(*id);
+                        self.graph.type_nodes.get_mut(&root).unwrap().deferred_join = true;
+                    }
+                }
+            }
+            return Ok(AnchorOutcome::Compatible);
+        }
+        if state == Some(true) {
+            if let Some((nodes, obligations)) = snapshot {
+                self.graph.type_nodes = nodes;
+                self.graph.obligations = obligations;
+                return Ok(AnchorOutcome::Absorbed);
+            }
+            if xv("retract") {
+                self.retract_pending_joins(before);
+            } else {
+                self.truncate_pending_joins(before);
+            }
+            return Ok(AnchorOutcome::Absorbed);
+        }
+        if state == Some(false) {
+            if let Some(nodes) = snapshot0 {
+                for (id, node) in nodes {
+                    self.graph.type_nodes.insert(id, node);
+                }
+            }
+            self.graph.union_denounced.insert(key, true);
+        }
+        Ok(match error {
+            Some(error) => AnchorOutcome::Reported(error),
+            None => AnchorOutcome::Pending,
+        })
+    }
