+    /// Removes the pending joins registered after `length` together with the
+    /// per-node marks they left, so a rejected equality leaves no trace
+    /// (F0-0002 4.1.2.2: the rejection is atomic).
+    fn retract_pending_joins(&mut self, length: usize) {
+        let mut seen = 0;
+        let mut removed: Vec<(u64, bool)> = Vec::new();
+        self.graph.obligations.retain(|entry| match entry {
+            ObligationKind::Join(join) => {
+                seen += 1;
+                if seen > length {
+                    removed.push((join.constructor, join.branch));
+                    false
+                } else {
+                    true
+                }
+            }
+            _ => true,
+        });
+        for (constructor, branch) in removed.into_iter().rev() {
+            let root = self.root(constructor);
+            let remaining = self
+                .pending_joins()
+                .any(|join| join.constructor == constructor);
+            let node = self.graph.type_nodes.get_mut(&root).unwrap();
+            if branch {
+                node.branch_join_scopes.pop();
+            }
+            if !remaining {
+                node.deferred_join = false;
+                node.recursive_join = false;
+            }
+        }
