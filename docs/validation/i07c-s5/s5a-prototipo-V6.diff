+    /// A seeded layer that the pass did not itself traverse with a real
+    /// equality is unjustified: the equality that planned it was rejected
+    /// under the semantics of the pass that used the seed. Retract it. Each
+    /// site's cap only decreases, so retraction terminates after at most the
+    /// total number of planned layers.
+    fn retract_unconsumed_seeds(&mut self) -> bool {
+        // A seeded node is witnessed by the pass when an equality that is
+        // not itself planned reached it: it shares a component with an
+        // unseeded node, or carries a concrete type. Two seeded nodes merged
+        // with each other justify nothing.
+        let seed_nodes: HashSet<u64> = self.graph.preseeded_layer.keys().copied().collect();
+        let all_nodes: Vec<u64> = self.graph.type_nodes.keys().copied().collect();
+        let mut witnessed_roots: HashSet<u64> = HashSet::new();
+        for id in all_nodes {
+            if !seed_nodes.contains(&id) {
+                witnessed_roots.insert(self.root(id));
+            }
+        }
+        let seeded: Vec<u64> = self.graph.preseeded_layer.keys().copied().collect();
+        let mut unconsumed: Vec<(u64, usize)> = Vec::new();
+        for child in seeded {
+            let root = self.root(child);
+            let node = &self.graph.type_nodes[&root];
+            let witnessed = witnessed_roots.contains(&root)
+                || node.concrete.is_some()
+                || !self.graph.preseeded_children.contains(&child);
+            if !witnessed && let Some(layer) = self.graph.preseeded_layer.get(&child).copied() {
+                unconsumed.push(layer);
+            }
+        }
+        let mut changed = false;
+        for (site, index) in unconsumed {
+            let cap = self.graph.seed_cap.entry(site).or_insert(usize::MAX);
+            if index < *cap {
+                *cap = index;
+                changed = true;
+            }
+        }
+        changed
+    }
