fn main() {
    var original = [[1, 2], [3, 4]];
    var copy = original;
    copy[0][1] = 9;
    assert_eq(original[0][1], 2);
    assert_eq(copy[0][1], 9);
    var third = copy;
    third[1] = [7, 8];
    assert_eq(copy[1], [3, 4]);
    original = third;
    third[0][0] = 42;
    assert_eq(original[0][0], 1);
    print(original);
}
