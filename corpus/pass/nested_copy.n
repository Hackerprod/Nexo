fn Main() {
    var original = [[1, 2], [3, 4]];
    var copy = original;
    copy[0][1] = 9;
    AssertEq(original[0][1], 2);
    AssertEq(copy[0][1], 9);
    var third = copy;
    third[1] = [7, 8];
    AssertEq(copy[1], [3, 4]);
    original = third;
    third[0][0] = 42;
    AssertEq(original[0][0], 1);
    Print(original);
}
